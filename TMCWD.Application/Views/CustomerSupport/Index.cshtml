<!-- End Deactivate Modal Window -->

<script type="text/javascript">

    var deactivateLinks = document.getElementsByClassName("lnkDeactivate");
    var customerId = 0;

    [...deactivateLinks].forEach((link) => {
        link.addEventListener("click", (evt) => {
            evt.preventDefault();
            customerId = evt.target.parentElement.dataset.id;

            var modal = new ModalDialog({
                type: 'deactivate',
                title: 'Deactivate Customer',
                content: 'Are you sure you want to deactivate customer? All of customer data will be permanently removed. This action cannot be undone.',
                submitCallback: () => {
                    window.location.href = '@Url.Action("DeactivateCustomer", "CustomerSupport")' + '?customerId=' + customerId;
                }
            });

            modal.show();

            // showModalDialog({
            //     type: 'deactivate',
            //     submitUrl: 'Url.Action("DeactivateCustomer", "CustomerSupport")' + '?customerId=' + customerId,
            //     title: 'Deactivate Customer',
            //     content: 'Are you sure you want to deactivate customer? All of customer data will be permanently removed. This action cannot be undone.'
            // });
        });
    });
</script>