@{
    Layout = "_insideLayout";
}

@model TMCWD.Application.Models.RequestViewModel

<div class="p-6 bg-white border border-gray-200 rounded-lg shadow-sm mt-1">
    <h5 class="mb-2 text-2xl font-bold text-gray-900">Request Details</h5>
    <p class="text-gray-700">
        @using(Html.BeginForm("SaveRequest", "CustomerSupport"))
        {
            @Html.HiddenFor(x => x.CurrentUser.Id)
            @Html.HiddenFor(x => x.AddEditRequest.Id)
            @Html.HiddenFor(x => x.AddEditRequest.DateCreated)
            @Html.HiddenFor(x => x.AddEditRequest.CreatedBy)

            <div class="grid gap-6 mb-6 md:grid-cols-2">
                <div>
                    <label for="pControlNumber" class="block mb-2.5 text-sm font-medium text-heading">Control No.</label>
                    @if(Model.AddEditRequest.Id > 0){
                        <p id="pControlNumber" class="mb-3 text-body">@Model.AddEditRequest.ControlNumber</p>
                    }
                    else
                    {
                        <p id="pControlNumber" class="mb-3 text-body">Not yet created</p>
                    }
                </div>
                <div>
                    <label for="pDate" class="block mb-2.5 text-sm font-medium text-heading">Date</label>
                    @if(Model.AddEditRequest.Id > 0){
                        <p id="pDate" class="mb-3 text-body">@Model.AddEditRequest.DateCreated.ToString("dd MMM yyyy")</p>
                    }
                    else
                    {
                        <p id="pDate" class="mb-3 text-body">@DateTime.Now.ToString("dd MMM yyyy")</p>
                    }
                </div>
                <div>
                    @if(Model.CurrentCustomer.Id > 0)
                    {
                        <label for="pAccountName" class="block mb-2.5 text-sm font-medium text-heading">Account Name</label>
                        <p id="pAccountName" class="mb-3 text-body">@(Model.CurrentCustomer.Lastname + ", " + Model.CurrentCustomer.Firstname)</p>
                    }
                    else
                    {
                        @Html.LabelFor(x => x.CurrentCustomer.Firstname, new { @class = "block mb-2.5 text-sm font-medium text-heading" })
                        @Html.TextBoxFor(x => x.CurrentCustomer.Firstname, new { id = "txtAccountName", @class = "bg-neutral-secondary-medium border border-default-medium text-heading text-sm rounded-lg focus:ring-brand focus:border-brand block w-full px-3 py-2.5 shadow-xs placeholder:text-body", required = "required", placeholder = "Name" })
                    }
                </div>
                <div>
                    @if (Model.CurrentAccount.Id > 0)
                    {
                        <label for="pAccountNo" class="block mb-2.5 text-sm font-medium text-heading">Account No</label>
                        <p id="pAccountNo" class="mb-3 text-body">@(Model.CurrentAccount.AccountNumber)</p>
                    }
                    else
                    {
                        @Html.LabelFor(x => x.CurrentAccount.AccountNumber, new { @class = "block mb-2.5 text-sm font-medium text-heading" })
                        @Html.TextBoxFor(x => x.CurrentAccount.AccountNumber, new { id = "txtAccountNo", @class = "bg-neutral-secondary-medium border border-default-medium text-heading text-sm rounded-lg focus:ring-brand focus:border-brand block w-full px-3 py-2.5 shadow-xs placeholder:text-body", required = "required", placeholder = "Name" })
                    }
                </div>
                <div>
                    @if (Model.CurrentAccount.Id > 0)
                    {
                        <label for="pAddress" class="block mb-2.5 text-sm font-medium text-heading">Service Address</label>
                        <p id="pAddress" class="mb-3 text-body">@(Model.CurrentAccount.Address)</p>
                    }
                    else
                    {
                        @Html.LabelFor(x => x.CurrentAccount.Address, new { @class = "block mb-2.5 text-sm font-medium text-heading" })
                        @Html.TextBoxFor(x => x.CurrentAccount.Address, new { id = "txtAddress", @class = "bg-neutral-secondary-medium border border-default-medium text-heading text-sm rounded-lg focus:ring-brand focus:border-brand block w-full px-3 py-2.5 shadow-xs placeholder:text-body", required = "required", placeholder = "Name" })
                    }
                </div>
                <div>
                    @if (Model.CurrentCustomer.Id > 0)
                    {
                        <label for="pPhone" class="block mb-2.5 text-sm font-medium text-heading">Contact No.</label>
                        <p id="pPhone" class="mb-3 text-body">@(Model.CurrentCustomer.PhoneNumber)</p>
                    }
                    else
                    {
                        @Html.LabelFor(x => x.CurrentCustomer.PhoneNumber, new { @class = "block mb-2.5 text-sm font-medium text-heading" })
                        @Html.TextBoxFor(x => x.CurrentCustomer.PhoneNumber, new { id = "txtPhone", @class = "bg-neutral-secondary-medium border border-default-medium text-heading text-sm rounded-lg focus:ring-brand focus:border-brand block w-full px-3 py-2.5 shadow-xs placeholder:text-body", required = "required", placeholder = "Name" })
                    }
                </div>
                <div class="border border-gray-200 grid col-span-2 gap-6">

                </div>
            </div>
            <div>
                <button type"submit" class="px-4 py-2 bg-blue-600 text-white font-semibold rounded-md hover:bg-blue-700 transition duration-150">
                    Save
                </button>
                <button type="button" class="px-4 py-2 bg-orange-600 text-black font-semibold rounded-md hover:bg-gray-700 transition duration-150" onclick="location.href='@Url.Action("Index", "Admin")'">
                    Cancel
                </button>
            </div>
        }
    </p>
</div>