@model TMCWD.Application.Models.CustomerSelectionViewModel

<el-dialog>
    <dialog id="customerSelectionDialog" aria-labelledby="dialog-title" class="fixed inset-0 size-auto max-h-none max-w-none overflow-y-auto bg-transparent backdrop:bg-transparent">
        <el-dialog-backdrop class="fixed inset-0 bg-gray-500/75 transition-opacity data-closed:opacity-0 data-enter:duration-300 data-enter:ease-out data-leave:duration-200 data-leave:ease-in"></el-dialog-backdrop>

        <div tabindex="0" class="flex min-h-full items-end justify-center p-4 text-center focus:outline-none sm:items-center sm:p-0">
            <el-dialog-panel class="relative transform overflow-hidden rounded-lg bg-white text-left shadow-xl transition-all data-closed:translate-y-4 data-closed:opacity-0 data-enter:duration-300 data-enter:ease-out data-leave:duration-200 data-leave:ease-in sm:my-8 sm:w-full sm:max-w-[80%] data-closed:sm:translate-y-0 data-closed:sm:scale-95">
                <div class="bg-white px-4 pt-5 pb-4 sm:p-6 sm:pb-4">
                    <div class="sm:flex sm:items-start">
                        <div class="mt-3 text-center sm:mt-0 sm:ml-4 sm:text-left w-full">
                            <div class="grid grid-cols-[80%_20%]">
                                <div>
                                    <input 
                                        type="text" id="txtCustomerName" class="bg-neutral-secondary-medium border border-default-medium text-heading text-sm rounded-lg focus:ring-brand focus:border-brand block w-full px-2.5 py-2 shadow-xs placeholder:text-body" placeholder="e.g. Firstname or Lastname, or Firstname + space + Lastname" required="">
                                </div>
                                <div class="pl-4">
                                    <button id="btnSearchCustomer" class="bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded">
                                        <i class="fa fa-search" aria-hidden="true"></i>
                                    </button>
                                </div>
                            </div>
                            <div class="mt-2">
                                <div class="relative overflow-x-auto bg-neutral-primary-soft shadow-xs rounded-lg border border-default">
                                    <table id="tblCustomerList" class="w-full text-sm text-left rtl:text-right text-body">
                                        <thead class=" text-sm text-body bg-neutral-secondary-soft border-b rounded-lg border-default">
                                            <tr>
                                                <th scope="col" class="px-6 py-3 font-medium text-center"></th>
                                                <th scope="col" class="px-6 py-3 font-medium text-center">Name</th>
                                                <th scope="col" class="px-6 py-3 font-medium text-center">Email</th>
                                                <th scope="col" class="px-6 py-3 font-medium text-center">Phone</th>
                                                <th scope="col" class="px-6 py-3 font-medium text-center">Active</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr>
                                                <td scope="col" class="px-6 py-3 font-medium text-center" colspan="5">
                                                    No record(s) found...
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="bg-gray-50 px-4 py-3 sm:flex sm:flex-row-reverse sm:px-6">
                    <button id="btnCustomerSelectPick" type="button" command="close" commandfor="dialog" class="inline-flex w-full justify-center rounded-md bg-green-600 px-3 py-2 text-sm font-semibold text-white shadow-xs hover:bg-green-500 sm:ml-3 sm:w-auto">Select</button>
                    <button id="btnCustomerSelectCancel" type="button" command="close" commandfor="dialog" class="mt-3 inline-flex w-full justify-center rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-900 shadow-xs inset-ring inset-ring-gray-300 hover:bg-gray-50 sm:mt-0 sm:w-auto">Cancel</button>
                </div>
            </el-dialog-panel>
        </div>
    </dialog>
</el-dialog>

@* <script src="~/js/site.js"></script> *@
<script type="text/javascript">

    document.addEventListener("DOMContentLoaded", function(event) {
        const btnCustomerSelectCancel = document.getElementById("btnCustomerSelectCancel");
        const btnCustomerSelectPick = document.getElementById("btnCustomerSelectPick");
        const btnSearchCustomer = document.getElementById("btnSearchCustomer");
        const customerSelectionDialog = document.getElementById("customerSelectionDialog");
        
        btnCustomerSelectCancel.onclick = (evt) => {
            evt.preventDefault();
            customerSelectionDialog.close();
        };

        btnSearchCustomer.onclick = async (evt) => {
            evt.preventDefault();
            const txtCustomerName = document.getElementById("txtCustomerName");
            var url = '@Url.Action("SearchCustomer", "CustomerSupport")?searchString=' + encodeURIComponent(txtCustomerName.value);
            var client = new WebClient(url, null);
            var result = await client.getAsync();
            if(result){
                var tbody = document.querySelector("#tblCustomerList tbody");
                tbody.replaceChildren();
                
                for(var ctr = 0; ctr < result.length; ctr++){
                    var customer = result[ctr];
                    var tr = document.createElement("tr");
                    tr.classList.add("bg-white", "border-b", "hover:bg-gray-50");
                    tr.innerHTML = `
                        <td class="px-6 py-4 text-center">
                            <input data-customerid="${customer.id}" data-customername="${customer.firstname} {customer.lastname}" type="radio" name="customerSelect" value="${customer.id}">
                        </td>
                        <td class="px-6 py-4">${customer.firstname} ${customer.lastname}</td>
                        <td class="px-6 py-4">${customer.email}</td>
                        <td class="px-6 py-4">${customer.phoneNumber}</td>
                        <td class="px-6 py-4 text-center">
                            ${customer.isActive ? '<i class="fa-solid fa-check text-green-500"></i>' : '<i class="fa-solid fa-xmark text-red-500"></i>'}
                        </td>
                    `;
                    tbody.appendChild(tr);
                }
            }
        };

        btnCustomerSelectPick.onclick = async (evt) => {
            var selectedRadio = document.querySelectorAll('input[type="radio"]:checked');
            if(selectedRadio){
                var customerId = selectedRadio[0].dataset.customerid;
                var customerName = selectedRadio[0].dataset.customername;
                const valueElement = document.getElementById("@Model.SelectedValueContainerId");
                // const textElement = document.getElementById("@Model.SelectedNameContainerId");
                // textElement.value = customerName;
                valueElement.value = customerId;
                var urlEncoded = encodeURIComponent("bg-neutral-secondary-medium border border-default-medium text-heading text-sm rounded-lg focus:ring-brand focus:border-brand block w-full px-3 py-2.5 shadow-xs placeholder:text-body");
                var url = '@Url.Action("RefreshCustomerNameComponent", "CustomerSupport")' + "?customerId=" + customerId + "&pId=pAccountName&pClass=" + urlEncoded;
                const response = await fetch(url);
                document.getElementById("@Model.ParentContainerId").innerHTML = await response.text();
                customerSelectionDialog.close();
            }
        }

    });

</script>