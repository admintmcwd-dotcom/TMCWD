<script type="text/javascript">

    //var deactivateLinks = document.getElementsByClassName("deactivateLink");
    const table = document.getElementById("tblUsers");
    const searchText = document.getElementById("txtSearchString");
    //stockCheck: { srcDataMember: 'quantity', compareToDataMember: 'requiredQuantity' },
    table.DataTable({
        processing: true,
        getUrl: '@Url.Action("GetUsers", "Admin")' + '?searchString=' + searchText.value,
        columns: 
        [
            { dataMember: 'id', isEditable: false },
            { dataMember: 'name', isEditable: false },
            { dataMember: 'email', isEditable: false },
            { dataMember: 'dateCreated', isEditable: false },
            {
                dataMember: 'isActive', 
                isEditable: false,
                displays:
                [
                    {
                        value: 'True',
                        icon: 'fa-solid fa-check text-green-500'
                    },
                    {
                        value: 'False',
                        icon: 'fa-solid fa-xmark text-red-500'
                    }
                ],
                isCentered: true
            }
        ],
        buttons:
        [
            { className: 'fa-solid fa-pencil', isEditButton: false, clickCallback: (data) => editUser(data) },
